widget "updates" {
  page: 4
  order: 2
  size: 3x3
  minSize: 2x2

  requires { pacman: ["jq"] }

  // How many days old the system's nixpkgs is, from its lock in ~/.config/nix-on-droid. Tapping updates the
  // lock and switches to it.
  source age = cmd("""
    t=$(nix flake metadata ~/.config/nix-on-droid --json 2>/dev/null | jq -r '.locks.nodes.nixpkgs.locked.lastModified // empty')
    [ -n "$t" ] && echo $(( ($(date +%s) - t) / 86400 ))
  """) every 1h timeout 90s
  let days = age == null || age == "" ? null : num(age)

  onTap: terminal("nix flake update --flake ~/.config/nix-on-droid && nix-on-droid switch --flake ~/.config/nix-on-droid", "updates")

  Column {
    gap: 2
    Text { text: "nixpkgs"; style: muted }
    Text {
      text: days == null ? "…" : "${days}d"
      style: title
      color: days == null ? muted : days > 30 ? yellow : green
    }
    Text { text: days == null ? "" : days > 30 ? "tap to update" : "up to date"; style: small; maxLines: 2 }
  }
}
