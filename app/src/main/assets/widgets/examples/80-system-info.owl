widget "system" {
  page: 2
  order: 4
  size: 6x3
  minSize: 3x2

  requires { pacman: ["uptime", "fastfetch"] }

  source info = cmd("printf '{\"kernel\":\"%s\",\"packages\":%s,\"up\":\"%s\"}' \"$(uname -r | cut -d- -f1)\" \"$(nix-store -qR ~/.nix-profile | wc -l)\" \"$(uptime -p | sed 's/up //')\"") every 10m json

  onTap: terminal("fastfetch")

  Column {
    Text { text: "nix-on-droid"; style: muted }
    Text { text: "kernel ${info.kernel}"; style: small }
    Text { text: "${info.packages} packages"; style: small }
    Text { text: "up ${info.up}"; style: small }
  }
}
